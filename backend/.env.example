# Copy to .env and adapt. Never commit the real .env file.
PORT=3000
DATABASE_URL=postgres://iap:iap@localhost:5432/iap
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Only used by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
